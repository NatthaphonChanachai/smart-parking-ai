,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 0.5,\n                    \"font_thickness\": 1,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model\",\n                            \"config_path\": \"C:/Users/mint/Downloads/image-20261114T164158Z-1-001/image/trained\"\n                        },\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model2\",\n                            \"config_path\": \"C:/Users/mint/Downloads/20261125_07_33_07_0.5736/20261125_07_33_07_0.5736\"\n                        },\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model3\",\n                            \"config_path\": \"C:/Users/mint/Downloads/20261125_09_05_40_0.114/20261125_09_05_40_0.114\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 1,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {},\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": true,\n                    \"this_config_name\": \"model3\",\n                    \"thresh\": 15,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": []\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 340,\n                \"y\": 272\n            }\n        },\n        {\n            \"id\": \"{a9820ed2-40e1-448e-b6d7-9284c674b793}\",\n            \"model\": {\n                \"height\": 463,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 776\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 697,\n                \"y\": 187\n            }\n        },\n        {\n            \"id\": \"{56f11dbd-1739-446b-837c-f2cae1487a6a}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 17,\n                \"y\": 646\n            }\n        },\n        {\n            \"id\": \"{13cd91d5-720b-4efa-84c6-f02974acbfa8}\",\n            \"model\": {\n                \"height\": 474,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 725\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 714,\n                \"y\": 731\n            }\n        },\n        {\n            \"id\": \"{28321c59-6272-4336-b003-b7a06167dc54}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C03\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C03\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 476,\n                \"y\": 739\n            }\n        },\n        {\n            \"id\": \"{dfdf7bc0-4cee-4381-ad6f-ea3008be837e}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": true\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -17,\n                \"y\": 272\n            }\n        },\n        {\n            \"id\": \"{0dbea9f0-a968-4f89-81e2-bcc76604e5d9}\",\n            \"model\": {\n                \"mqtt_pub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 0,\n                    \"send_img\": false,\n                    \"topic\": \"parking/raw/2A-C02\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttPub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 544,\n                \"y\": 272\n            }\n        },\n        {\n            \"id\": \"{0b1a76f9-f5ce-4285-aa49-6204fc4f0e49}\",\n            \"model\": {\n                \"mqtt_pub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 0,\n                    \"send_img\": false,\n                    \"topic\": \"parking/raw/2A-C03\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttPub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 476,\n                \"y\": 646\n            }\n        },\n        {\n            \"id\": \"{681b95ad-83cc-4e7f-a797-e4fc44c31be2}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -51,\n                \"y\": 1003\n            }\n        },\n        {\n            \"id\": \"{37707f17-202f-49bc-8a37-3552dbb3fbc2}\",\n            \"model\": {\n                \"data\": {\n                    \"curr_tap\": 0,\n                    \"draw_roi\": true,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 0.5,\n                    \"font_thickness\": 1,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model\",\n                            \"config_path\": \"C:/Users/mint/Downloads/image-20261114T164158Z-1-001/image/trained\"\n                        },\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model2\",\n                            \"config_path\": \"C:/Users/mint/Downloads/20261125_07_33_07_0.5736/20261125_07_33_07_0.5736\"\n                        },\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"model3\",\n                            \"config_path\": \"C:/Users/mint/Downloads/20261125_09_05_40_0.114/20261125_09_05_40_0.114\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 1,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {},\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": true,\n                    \"this_config_name\": \"model2\",\n                    \"thresh\": 15,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": []\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 323,\n                \"y\": 1037\n            }\n        },\n        {\n            \"id\": \"{ac1c1421-ca88-477b-87ec-97f4de237c1d}\",\n            \"model\": {\n                \"height\": 625,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 931\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 748,\n                \"y\": 1173\n            }\n        },\n        {\n            \"id\": \"{32f30bf9-8ce7-4de6-90a5-4f11185467ba}\",\n            \"model\": {\n                \"data\": {},\n                \"name\": \"WebCam \",\n                \"node_enable\": true,\n                \"setting\": {\n                    \"webcamUUID\": \"FA9-3EF\"\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 136,\n                \"y\": 1020\n            }\n        },\n        {\n            \"id\": \"{3a6492f5-9f65-413d-a9df-23e14f24730d}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C01\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 241,\n                        \"splt1\": 150\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C01\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 527,\n                \"y\": -26\n            }\n        },\n        {\n            \"id\": \"{37324522-77ea-442a-9086-a3ca78ab65e0}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C02\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C02\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 510,\n                \"y\": 382\n            }\n        },\n        {\n            \"id\": \"{b557335a-e4e1-46d4-a8ff-7aca7d092147}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C04\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C04\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA CORE starts this script with a FRESH Python state on every frame\\n# (even builtins are reset), so anything that must survive between frames\\n# (smoothing, the auto-ROI buffer) is kept in a small JSON file per camera.\\nimport os, json, tempfile\\nSTATE_FILE = os.path.join(tempfile.gettempdir(), \\\"spk_overlay_%s.json\\\" % CAM)\\ntry:\\n\\twith open(STATE_FILE, encoding=\\\"utf-8\\\") as _fh:\\n\\t\\tG = json.load(_fh)\\nexcept Exception:\\n\\tG = {}\\nG.setdefault(\\\"spk_state\\\", {})\\n\\n\\ndef _save_state():\\n\\ttry:\\n\\t\\ttmp = STATE_FILE + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(G, fh, separators=(\\\",\\\", \\\":\\\"))\\n\\t\\tos.replace(tmp, STATE_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save state:\\\", e)\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\n# ---- AUTO ROI: learn the slot layout from where the AI sees slots ---------\\n# The model boxes every slot (occupied or empty), so the box centres of the\\n# last ~45 frames tell us where the real slots are. Every 3 s we rebuild the\\n# layout; it is only used when it finds exactly as many slots as the floor has\\n# (otherwise the last good layout stays). The result is shared with Node-RED\\n# through parking-roi.json so the dashboard always matches what CiRA draws.\\nAUTO_ROI = True\\nROI_FILE = r\\\"C:\\\\Users\\\\mint\\\\.node-red\\\\parking-roi.json\\\"\\nWINDOW, EVERY = 45, 3.0\\n\\n\\ndef _median(a):\\n\\ta = sorted(a)\\n\\treturn a[len(a) // 2] if a else 0.0\\n\\n\\ndef _file_roi():\\n\\ttry:\\n\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\ts = json.load(fh).get(CAM)\\n\\t\\tif s and len(s) == len(ROI[CAM]):\\n\\t\\t\\treturn [(d[\\\"id\\\"], d[\\\"x1\\\"], d[\\\"x2\\\"], d.get(\\\"y1\\\"), d.get(\\\"y2\\\"), d.get(\\\"type\\\", \\\"normal\\\")) for d in s]\\n\\texcept Exception:\\n\\t\\tpass\\n\\treturn None\\n\\n\\ndef _save_roi(slots):\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\twith open(ROI_FILE, encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\t\\to = json.load(fh)\\n\\t\\texcept Exception:\\n\\t\\t\\to = {}\\n\\t\\to[CAM] = [dict(id=s[0], x1=s[1], x2=s[2], type=s[5], **({} if s[3] is None else {\\\"y1\\\": s[3], \\\"y2\\\": s[4]}))\\n\\t\\t\\t\\t  for s in slots]\\n\\t\\ttmp = ROI_FILE + \\\".\\\" + CAM + \\\".tmp\\\"\\n\\t\\twith open(tmp, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n\\t\\t\\tjson.dump(o, fh, indent=1)\\n\\t\\tos.replace(tmp, ROI_FILE)\\n\\texcept Exception as e:\\n\\t\\tprint(\\\"save roi:\\\", e)\\n\\n\\ndef _learn(frames, base):\\n\\t\\\"\\\"\\\"frames: list of [(cx, cy, w, h)] normalised -> new slot list or None\\\"\\\"\\\"\\n\\tpts = [p for fr in frames for p in fr]\\n\\tif len(frames) < 10 or not pts:\\n\\t\\treturn None\\n\\tmw, mh = _median([p[2] for p in pts]) or 0.1, _median([p[3] for p in pts]) or 0.1\\n\\tcl = []\\t\\t\\t\\t\\t\\t\\t\\t\\t # [sx, sy, sw, sh, n, set(frames)]\\n\\tfor fi, fr in enumerate(frames):\\n\\t\\tfor x, y, w, h in fr:\\n\\t\\t\\tbest, bd = None, 0.5\\n\\t\\t\\tfor c in cl:\\n\\t\\t\\t\\td = (((x - c[0] / c[4]) / mw) ** 2 + ((y - c[1] / c[4]) / mh) ** 2) ** 0.5\\n\\t\\t\\t\\tif d < bd:\\n\\t\\t\\t\\t\\tbest, bd = c, d\\n\\t\\t\\tif best is None:\\n\\t\\t\\t\\tbest = [0.0, 0.0, 0.0, 0.0, 0, set()]\\n\\t\\t\\t\\tcl.append(best)\\n\\t\\t\\tbest[0] += x; best[1] += y; best[2] += w; best[3] += h; best[4] += 1; best[5].add(fi)\\n\\tkeep = [(c[0] / c[4], c[1] / c[4], c[2] / c[4], c[3] / c[4]) for c in cl if len(c[5]) >= len(frames) * 0.4]\\n\\tif len(keep) != len(base):\\n\\t\\treturn None\\n\\tbase_rows = len(set(b[3] for b in base))   # 1 for full-height cameras (y = None)\\n\\tif base_rows == 1:\\n\\t\\trows = [sorted(keep, key=lambda c: c[0])]   # one row of slots: just left -> right\\n\\telse:\\n\\t\\tkeep.sort(key=lambda c: c[1])\\n\\t\\trows = []\\n\\t\\tfor c in keep:\\n\\t\\t\\tif rows and abs(c[1] - sum(r[1] for r in rows[-1]) / len(rows[-1])) < mh * 0.5:\\n\\t\\t\\t\\trows[-1].append(c)\\n\\t\\t\\telse:\\n\\t\\t\\t\\trows.append([c])\\n\\t\\tif len(rows) != base_rows:\\n\\t\\t\\treturn None\\n\\tfor r in rows:\\n\\t\\tr.sort(key=lambda c: c[0])\\n\\tsingle = base_rows == 1 and base[0][3] is None\\n\\try = [[min(c[1] - c[3] * 0.6 for c in r), max(c[1] + c[3] * 0.6 for c in r)] for r in rows]\\n\\tfor i in range(len(ry) - 1):\\n\\t\\tif ry[i][1] > ry[i + 1][0]:\\n\\t\\t\\tm = (ry[i][1] + ry[i + 1][0]) / 2\\n\\t\\t\\try[i][1] = ry[i + 1][0] = m\\n\\tcl3 = lambda v: round(min(1.0, max(0.0, v)), 3)\\n\\tout = []\\n\\tfor ri, r in enumerate(rows):\\n\\t\\tfor i, c in enumerate(r):\\n\\t\\t\\tx1 = (0.0 if single else c[0] - c[2] * 0.6) if i == 0 else (r[i - 1][0] + c[0]) / 2\\n\\t\\t\\tx2 = (1.0 if single else c[0] + c[2] * 0.6) if i == len(r) - 1 else (c[0] + r[i + 1][0]) / 2\\n\\t\\t\\tb = base[len(out)]\\t\\t\\t\\t  # keep slot id + type in reading order\\n\\t\\t\\tout.append((b[0], cl3(x1), cl3(x2), None if single else cl3(ry[ri][0]),\\n\\t\\t\\t\\t\\t\\tNone if single else cl3(ry[ri][1]), b[5]))\\n\\t\\t\\t# sanity: a slot may drift with the camera, but not jump to another slot's place\\n\\t\\t\\tif abs(c[0] - (b[1] + b[2]) / 2) > 0.25 or (b[3] is not None and abs(c[1] - (b[3] + b[4]) / 2) > 0.25):\\n\\t\\t\\t\\treturn None\\n\\treturn out\\n\\n\\ndef roi_for(objs, W0, H0, now):\\n\\tif \\\"roi\\\" not in G:\\n\\t\\tsaved = _file_roi()\\n\\t\\tG[\\\"roi\\\"] = saved or [list(s) for s in ROI[CAM]]\\n\\t\\tG[\\\"roi_src\\\"] = \\\"SAVED\\\" if saved else \\\"DEFAULT\\\"\\n\\t\\tG[\\\"buf\\\"], G[\\\"cal_t\\\"], G[\\\"buf_t\\\"] = [], now, 0\\n\\tif AUTO_ROI:\\n\\t\\tnames = OCC_NAMES + FREE_NAMES\\n\\t\\tif now - G.get(\\\"buf_t\\\", 0) >= 0.12:\\t # sample ~8 frames/s is plenty\\n\\t\\t\\tG[\\\"buf_t\\\"] = now\\n\\t\\t\\tG[\\\"buf\\\"].append([[round(o[\\\"x\\\"] / W0, 4), round(o[\\\"y\\\"] / H0, 4), round(o.get(\\\"w\\\", 0) / W0, 4),\\n\\t\\t\\t\\t\\t\\t\\t  round(o.get(\\\"h\\\", 0) / H0, 4)] for o in objs\\n\\t\\t\\t\\t\\t\\t\\t if str(o.get(\\\"name\\\", \\\"\\\")).strip().lower() in names and float(o.get(\\\"confidence\\\", 0)) >= 0.3])\\n\\t\\t\\tdel G[\\\"buf\\\"][:-WINDOW]\\n\\t\\tif now - G[\\\"cal_t\\\"] >= EVERY:\\n\\t\\t\\tG[\\\"cal_t\\\"] = now\\n\\t\\t\\tnew = _learn(G[\\\"buf\\\"], ROI[CAM])\\n\\t\\t\\tif new:\\n\\t\\t\\t\\tmoved = max(abs(a - b) for n, o in zip(new, G[\\\"roi\\\"]) for a, b in\\n\\t\\t\\t\\t\\t\\t\\tzip((n[1], n[2], n[3] or 0, n[4] or 0), (o[1], o[2], o[3] or 0, o[4] or 0)))\\n\\t\\t\\t\\tG[\\\"roi_src\\\"] = \\\"AUTO\\\"\\n\\t\\t\\t\\tif moved > 0.015:\\t\\t\\t   # only update/save when the layout really moved\\n\\t\\t\\t\\t\\tG[\\\"roi\\\"] = [list(s) for s in new]\\n\\t\\t\\t\\t\\t_save_roi(new)\\n\\treturn [tuple(s) for s in G[\\\"roi\\\"]]\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = roi_for(objs, W0, H0, now)\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  ROI %s  |  %s\\\" % (CAM, G.get(\\\"roi_src\\\", \\\"-\\\"), time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\nfinally:\\n\\t_save_state()\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 425,\n                \"y\": 1224\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -1170.1242883757607,\n        \"flow_view_pos_y\": -475.50883360865146,\n        \"flow_view_zoom_factor\": 0.35016460265893906,\n        \"scene_version\": 1\n    }\n}",
            "name": "Main"
        }
