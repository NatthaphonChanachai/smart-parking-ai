                 \"text_drawing\": true,\n                    \"this_config_name\": \"model2\",\n                    \"thresh\": 15,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": []\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 323,\n                \"y\": 1037\n            }\n        },\n        {\n            \"id\": \"{ac1c1421-ca88-477b-87ec-97f4de237c1d}\",\n            \"model\": {\n                \"height\": 625,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 931\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 748,\n                \"y\": 1173\n            }\n        },\n        {\n            \"id\": \"{32f30bf9-8ce7-4de6-90a5-4f11185467ba}\",\n            \"model\": {\n                \"data\": {},\n                \"name\": \"WebCam \",\n                \"node_enable\": true,\n                \"setting\": {\n                    \"webcamUUID\": \"FA9-3EF\"\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 136,\n                \"y\": 1020\n            }\n        },\n        {\n            \"id\": \"{3a6492f5-9f65-413d-a9df-23e14f24730d}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C01\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C01\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 527,\n                \"y\": -26\n            }\n        },\n        {\n            \"id\": \"{37324522-77ea-442a-9086-a3ca78ab65e0}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C02\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C02\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 510,\n                \"y\": 382\n            }\n        },\n        {\n            \"id\": \"{b557335a-e4e1-46d4-a8ff-7aca7d092147}\",\n            \"model\": {\n                \"data\": {\n                    \"comment\": \"\",\n                    \"py_ver\": \"2. Python311\",\n                    \"script\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C04\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                    \"tmp_path\": \"C:/Users/mint\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 16,\n                        \"splt1\": 10\n                    }\n                },\n                \"height\": 47,\n                \"name\": \"PythonScript\",\n                \"node_enable\": true,\n                \"python_code\": \"# =====================================================================\\n#  Smart Parking AI - Slot Overlay for CiRA CORE (PythonScript node)\\n#  Draws the parking-slot grid (same ROI as Node-RED \\\"Init ROI\\\") on top\\n#  of the video: green = free, red = occupied, grey = no detection,\\n#  blue = free accessible (PWD) slot - never recommended to general drivers,\\n#  plus slot IDs, the recommended slot, and a header with FREE x/y.\\n#\\n#  Wiring (each scene):  DeepDetect ──► MqttPub\\t\\t(unchanged)\\n#\\t\\t\\t\\t\\t\\t\\t\\t   └─► PythonScript   (this code)\\n#  Uses the variables CiRA gives the PythonScript node:\\n#\\t payload : dict  (contains payload[\\\"DeepDetect\\\"][\\\"objects\\\"])\\n#\\t img\\t : OpenCV image (BGR) - we draw on it in place\\n#  Only change CAM below for each scene.\\n# =====================================================================\\nimport time\\nimport cv2\\n\\nCAM = \\\"2A-C04\\\"\\t\\t  # <<< 2A-C01 / 2A-C02 / 2A-C03 / 2A-C04\\nCONF = 0.5\\t\\t\\t  # same threshold as Node-RED Slot Logic\\nHOLD = 3\\t\\t\\t\\t# frames a new status must persist before shown\\n\\nROI = {\\n\\t\\\"2A-C01\\\": [(\\\"01\\\", 0.00, 0.33, None, None, \\\"pwd\\\"), (\\\"02\\\", 0.33, 0.67, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"03\\\", 0.67, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C02\\\": [(\\\"04\\\", 0.00, 0.65, None, None, \\\"pwd\\\"), (\\\"05\\\", 0.65, 1.00, None, None, \\\"normal\\\")],\\n\\t\\\"2A-C03\\\": [(\\\"06\\\", 0.00, 0.33, None, None, \\\"normal\\\"), (\\\"07\\\", 0.33, 0.66, None, None, \\\"normal\\\"),\\n\\t\\t\\t   (\\\"08\\\", 0.66, 1.00, None, None, \\\"normal\\\")],\\n\\t# webcam (landscape): top row 09-14, bottom row 15-20 - same values as Node-RED Init ROI\\n\\t\\\"2A-C04\\\": [(\\\"%02d\\\" % (9 + i), x1, x2, 0.00, 0.40, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.07, .19), (.19, .30), (.30, .40), (.40, .51), (.51, .61), (.61, .75)])] +\\n\\t\\t\\t  [(\\\"%02d\\\" % (15 + i), x1, x2, 0.60, 1.00, \\\"normal\\\") for i, (x1, x2) in enumerate(\\n\\t\\t\\t\\t   [(.06, .20), (.20, .30), (.30, .42), (.42, .52), (.52, .63), (.63, .78)])],\\n}\\nFLOOR = {\\\"2A-C01\\\": \\\"FLOOR 1\\\", \\\"2A-C02\\\": \\\"FLOOR 2\\\", \\\"2A-C03\\\": \\\"FLOOR 3\\\", \\\"2A-C04\\\": \\\"FLOOR 4\\\"}\\nOCC_NAMES = (\\\"occupied\\\", \\\"car\\\")\\nFREE_NAMES = (\\\"empty\\\", \\\"avalible\\\", \\\"available\\\", \\\"free\\\")\\n\\nGREEN, RED, GREY = (90, 211, 34), (94, 77, 255), (150, 150, 150)   # BGR\\nBLUE = (235, 140, 40)   # free accessible (PWD) slot - shown, never recommended\\nORANGE, WHITE, DARK = (59, 173, 255), (255, 255, 255), (24, 18, 10)\\n\\n# ---- state kept between frames ---------------------------------------\\n# CiRA runs this script with fresh globals every frame, so keep state on\\n# the builtins module (shared by the whole interpreter), one entry per camera.\\nimport builtins\\nG = builtins.__dict__.setdefault(\\\"_spk_overlay\\\", {}).setdefault(\\n\\tCAM, {\\\"spk_state\\\": {}, \\\"spk_fps\\\": 0.0, \\\"spk_t\\\": time.time()})\\n\\n\\ndef slot_status(slots, objs, W, H):\\n\\t\\\"\\\"\\\"best confidence of each class whose box centre falls inside a slot\\\"\\\"\\\"\\n\\tres = {}\\n\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\tocc = free = 0.0\\n\\t\\tfor o in objs:\\n\\t\\t\\tcx, cy = o.get(\\\"x\\\", 0) / W, o.get(\\\"y\\\", 0) / H\\n\\t\\t\\tif not (x1 <= cx < x2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tif y1 is not None and not (y1 <= cy < y2):\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\tnm = str(o.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n\\t\\t\\tc = float(o.get(\\\"confidence\\\", 0))\\n\\t\\t\\tif nm in OCC_NAMES:\\n\\t\\t\\t\\tocc = max(occ, c)\\n\\t\\t\\telif nm in FREE_NAMES:\\n\\t\\t\\t\\tfree = max(free, c)\\n\\t\\tif occ >= CONF and occ >= free:\\n\\t\\t\\tres[sid] = (\\\"occupied\\\", occ)\\n\\t\\telif free >= CONF:\\n\\t\\t\\tres[sid] = (\\\"free\\\", free)\\n\\t\\telse:\\n\\t\\t\\tres[sid] = (\\\"unknown\\\", 0.0)\\n\\treturn res\\n\\n\\ndef smooth(sid, st):\\n\\ts = G[\\\"spk_state\\\"].setdefault(sid, [st, st, 0])\\n\\tif st == s[0]:\\n\\t\\ts[2] = 0\\n\\telif st == s[1]:\\n\\t\\ts[2] += 1\\n\\t\\tif s[2] >= HOLD:\\n\\t\\t\\ts[0], s[2] = st, 0\\n\\telse:\\n\\t\\ts[1], s[2] = st, 1\\n\\treturn s[0]\\n\\n\\ndef label(im, text, org, scale, fg, bg, th):\\n\\t(tw, tht), base = cv2.getTextSize(text, cv2.FONT_HERSHEY_DUPLEX, scale, th)\\n\\tx, y = org\\n\\tcv2.rectangle(im, (x, y - tht - base - 4), (x + tw + 10, y + 2), bg, -1)\\n\\tcv2.putText(im, text, (x + 5, y - base + 1), cv2.FONT_HERSHEY_DUPLEX, scale, fg, th, cv2.LINE_AA)\\n\\n\\ntry:\\n\\tif img is not None and CAM in ROI:\\n\\t\\tH, W = img.shape[:2]\\n\\t\\tk = W / 1280.0\\n\\t\\tth = max(1, int(round(2 * k)))\\n\\t\\tbar_h = int(46 * k)\\n\\t\\tdd = payload.get(\\\"DeepDetect\\\", {}) if isinstance(payload, dict) else {}\\n\\t\\tobjs = dd.get(\\\"objects\\\", []) or []\\n\\t\\tW0, H0 = float(dd.get(\\\"im_w\\\") or W), float(dd.get(\\\"im_h\\\") or H)\\n\\n\\t\\tnow = time.time()\\n\\n\\t\\tslots = ROI[CAM]\\n\\t\\traw = slot_status(slots, objs, W0, H0)\\n\\t\\tshown = {sid: smooth(sid, raw[sid][0]) for sid, *_ in slots}\\n\\n\\t\\t# recommended slot = first free NORMAL slot only (accessible/PWD slots are never recommended)\\n\\t\\trec = next((s[0] for s in slots if shown[s[0]] == \\\"free\\\" and s[5] == \\\"normal\\\"), None)\\n\\t\\ttyp_of = {s[0]: s[5] for s in slots}\\n\\n\\t\\tdef colour(sid, st):\\n\\t\\t\\tif st == \\\"free\\\":\\n\\t\\t\\t\\treturn BLUE if typ_of[sid] == \\\"pwd\\\" else GREEN\\n\\t\\t\\treturn RED if st == \\\"occupied\\\" else GREY\\n\\t\\tpulse = 0.5 + 0.5 * abs(((now * 1.5) % 2) - 1)\\t\\t# 0.5..1 blink\\n\\n\\t\\t# translucent fills\\n\\t\\tlayer = img.copy()\\n\\t\\tfor sid, x1, x2, y1, y2, _ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tcv2.rectangle(layer, p1, p2, colour(sid, shown[sid]), -1)\\n\\t\\ta = 0.22 if slots[0][3] is not None else 0.14\\t # lighter tint for full-height slots\\n\\t\\tcv2.addWeighted(layer, a, img, 1 - a, 0, img)\\n\\n\\t\\t# borders + ids\\n\\t\\tfor sid, x1, x2, y1, y2, typ in slots:\\n\\t\\t\\tp1 = (int(x1 * W) + 3, max(int((y1 or 0.0) * H), bar_h) + 3)\\n\\t\\t\\tp2 = (int(x2 * W) - 3, int((y2 if y2 is not None else 1.0) * H) - 3)\\n\\t\\t\\tst = shown[sid]\\n\\t\\t\\tcol = colour(sid, st)\\n\\t\\t\\tif sid == rec:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, ORANGE, th * 3)\\n\\t\\t\\t\\tg = int(255 * pulse)\\n\\t\\t\\t\\tlabel(img, \\\"GO >\\\", (p2[0] - int(80 * k), p1[1] + int(28 * k)), 0.6 * k, DARK, (59, g // 2 + 60, g), th)\\n\\t\\t\\telse:\\n\\t\\t\\t\\tcv2.rectangle(img, p1, p2, col, th)\\n\\t\\t\\ttag = sid + (\\\" PWD ONLY\\\" if typ == \\\"pwd\\\" else \\\"\\\")\\n\\t\\t\\tlabel(img, tag, (p1[0] + 4, p1[1] + int(28 * k)), 0.65 * k, WHITE, col, th)\\n\\t\\t\\tif st != \\\"unknown\\\":\\n\\t\\t\\t\\tcv2.putText(img, \\\"%d%%\\\" % round(raw[sid][1] * 100), (p1[0] + 8, p2[1] - int(8 * k)),\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.5 * k, WHITE, max(1, th - 1), cv2.LINE_AA)\\n\\n\\t\\t# header bar\\n\\t\\t# count normal slots only; accessible slots are reported separately\\n\\t\\tfree_n = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"normal\\\")\\n\\t\\ttotal = sum(1 for t in typ_of.values() if t == \\\"normal\\\")\\n\\t\\tpwd_total = len(slots) - total\\n\\t\\tpwd_free = sum(1 for sid, v in shown.items() if v == \\\"free\\\" and typ_of[sid] == \\\"pwd\\\")\\n\\t\\tcv2.rectangle(img, (0, 0), (W, bar_h), DARK, -1)\\n\\t\\tcv2.rectangle(img, (0, bar_h - th), (int(W * free_n / total), bar_h), GREEN, -1)\\n\\t\\ttxt = \\\"%s   FREE %d/%d\\\" % (FLOOR.get(CAM, CAM), free_n, total)\\n\\t\\tif pwd_total:\\n\\t\\t\\ttxt += \\\"   PWD %d/%d\\\" % (pwd_free, pwd_total)\\n\\t\\tcv2.putText(img, txt, (int(14 * k), int(32 * k)), cv2.FONT_HERSHEY_DUPLEX, 0.9 * k,\\n\\t\\t\\t\\t\\tGREEN if free_n else RED, th, cv2.LINE_AA)\\n\\t\\tif free_n == 0:\\n\\t\\t\\tlabel(img, \\\"FULL\\\", (int(W * 0.45), int(36 * k)), 0.9 * k, WHITE, (40, 40, int(200 + 55 * pulse)), th)\\n\\t\\tright = \\\"%s  |  AI LIVE  |  %s\\\" % (CAM, time.strftime(\\\"%H:%M:%S\\\"))\\n\\t\\t(tw, _), _ = cv2.getTextSize(right, cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k, th)\\n\\t\\tcv2.putText(img, right, (W - tw - int(14 * k), int(30 * k)), cv2.FONT_HERSHEY_SIMPLEX, 0.6 * k,\\n\\t\\t\\t\\t\\t(200, 190, 170), max(1, th - 1), cv2.LINE_AA)\\n\\t\\t# NOTE: don't write back into payload here - adding keys to payload from\\n\\t\\t# this node crashed CiRA CORE 1.9.4 (segfault). Node-RED does the counting.\\nexcept Exception as e:\\n\\tprint(\\\"overlay error:\\\", e)\\n\",\n                \"width\": 75\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 425,\n                \"y\": 1224\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -938.1025619337811,\n        \"flow_view_pos_y\": -651.5374937739297,\n        \"flow_view_zoom_factor\": 0.3851810629248324,\n        \"scene_version\": 1\n    }\n}",
